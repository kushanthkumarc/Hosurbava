rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAssessor() {
      return request.auth.token.role == 'assessor';
    }
    
    function isCoach() {
      return request.auth.token.role == 'coach';
    }
    
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    // Assessment videos
    match /assessment-videos/{assessmentId}/{fileName} {
      // Only assessors can upload videos for their assessments
      allow write: if isAuthenticated() && isAssessor() && 
        request.auth.uid == resource.metadata.uploadedBy;
      
      // Coaches and admins can read all videos, assessors can read their own
      allow read: if isAuthenticated() && (
        isCoach() ||
        isAdmin() ||
        (isAssessor() && request.auth.uid == resource.metadata.uploadedBy)
      );
      
      // File size limit: 50MB for videos
      allow write: if request.resource.size <= 50 * 1024 * 1024;
      
      // Only allow video files
      allow write: if request.resource.contentType.matches('video/.*');
    }

    // Profile pictures (optional feature)
    match /profile-pictures/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      // File size limit: 2MB for images
      allow write: if request.resource.size <= 2 * 1024 * 1024;
      
      // Only allow image files
      allow write: if request.resource.contentType.matches('image/.*');
    }

    // Report exports (PDF generation)
    match /report-exports/{assessmentId}/{fileName} {
      allow read: if isAuthenticated() && (
        isCoach() ||
        isAdmin()
      );
      
      // Only system can write (via Cloud Functions)
      allow write: if false;
    }

    // Temporary uploads (for processing)
    match /temp-uploads/{userId}/{fileName} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      // Auto-delete after 24 hours (handled by Cloud Functions)
      allow write: if request.resource.size <= 100 * 1024 * 1024; // 100MB limit
    }

    // System backups - admin only
    match /backups/{fileName} {
      allow read, write: if isAdmin();
    }
  }
}
