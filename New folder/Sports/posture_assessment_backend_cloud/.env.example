# Environment Configuration for Sports Posture Assessment Backend

# ==============================================
# DEVELOPMENT ENVIRONMENT (Emulators)
# ==============================================
# No environment variables needed for local development
# Emulators run with default configurations

# ==============================================  
# PRODUCTION ENVIRONMENT
# ==============================================

# Firebase Project Configuration
FIREBASE_PROJECT_ID=sports-posture-assessment-2025
FIREBASE_API_KEY=your-firebase-api-key-here
FIREBASE_AUTH_DOMAIN=sports-posture-assessment-2025.firebaseapp.com
FIREBASE_DATABASE_URL=https://sports-posture-assessment-2025-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=sports-posture-assessment-2025.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Cloud Functions Configuration
FUNCTIONS_REGION=us-central1
NODE_ENV=production

# Storage Configuration
MAX_FILE_SIZE=52428800
VIDEO_RETENTION_DAYS=30
ALLOWED_VIDEO_FORMATS=mp4,mov,avi

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Security Configuration
JWT_SECRET=your-jwt-secret-key
ENCRYPTION_KEY=your-encryption-key

# Analytics Configuration
ANALYTICS_ENABLED=true
LOG_LEVEL=info

# External API Keys (if needed)
GOOGLE_CLOUD_API_KEY=your-google-cloud-key
TENSORFLOW_API_KEY=your-ml-api-key

# ==============================================
# FLUTTER APP CONFIGURATION
# ==============================================

# For Flutter app to connect to Firebase
FLUTTER_FIREBASE_PROJECT_ID=sports-posture-assessment-2025
FLUTTER_FIREBASE_API_KEY=your-flutter-api-key
FLUTTER_FIREBASE_APP_ID=your-flutter-app-id

# Backend API Base URL
API_BASE_URL=https://us-central1-sports-posture-assessment-2025.cloudfunctions.net

# ==============================================
# EMULATOR CONFIGURATION (Development)
# ==============================================

# Emulator Ports
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
FIREBASE_EMULATOR_HUB=127.0.0.1:4400

# ==============================================
# INSTRUCTIONS
# ==============================================

# 1. For Development (Local):
#    - No .env file needed
#    - Emulators use default settings
#    - Just run: firebase emulators:start

# 2. For Production:
#    - Copy this file to .env
#    - Replace all "your-*" values with actual keys
#    - Deploy with: firebase deploy

# 3. For Flutter App:
#    - Use Firebase CLI to generate config files
#    - Run: flutter pub get
#    - Configure android/ios specific files
