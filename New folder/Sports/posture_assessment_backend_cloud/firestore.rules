rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for role checking
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAssessor() {
      return isAuthenticated() && getUserRole() == 'assessor';
    }
    
    function isCoach() {
      return isAuthenticated() && getUserRole() == 'coach';
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    function isOwnerOrCoach(resource) {
      return isAuthenticated() && (
        resource.data.assessorId == request.auth.uid || 
        isCoach() || 
        isAdmin()
      );
    }

    // User profiles - users can read/write their own profile, coaches/admins can read all
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isCoach() || 
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }

    // Assessment reports
    match /assessments/{assessmentId} {
      // Assessors can create and read their own assessments
      // Coaches can read all assessments
      // Admins have full access
      allow read: if isOwnerOrCoach(resource);
      
      allow create: if isAssessor() && 
        request.auth.uid == request.resource.data.assessorId &&
        request.resource.data.assessmentDate is timestamp &&
        request.resource.data.status in ['pending', 'completed'];
      
      allow update: if isAuthenticated() && (
        (isAssessor() && request.auth.uid == resource.data.assessorId) ||
        isCoach() ||
        isAdmin()
      ) && request.resource.data.assessorId == resource.data.assessorId; // Prevent assessor ID changes
      
      allow delete: if isAdmin();
    }

    // Athlete details - linked to assessments
    match /athletes/{athleteId} {
      allow read: if isAuthenticated() && (
        isCoach() || 
        isAdmin() ||
        exists(/databases/$(database)/documents/assessments/$(athleteId)) &&
        get(/databases/$(database)/documents/assessments/$(athleteId)).data.assessorId == request.auth.uid
      );
      
      allow write: if isAssessor() || isAdmin();
    }

    // Real-time notifications for coaches
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.recipientId ||
        isAdmin()
      );
      
      allow create: if isAssessor() || isAdmin();
      
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.recipientId ||
        isAdmin()
      );
      
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.recipientId ||
        isAdmin()
      );
    }

    // System configuration - admin only
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Audit logs - admin read only, system write
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true; // System-generated
    }

    // User sessions for analytics
    match /user_sessions/{sessionId} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid == resource.data.userId;
    }
  }
}
