{
  "name": "posture-assessment-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Sports Posture Assessment System",
  "scripts": {
    "build": "node --version && npm --version",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^11.8.0",
    "firebase-functions": "^4.3.1",
    "@google-cloud/storage": "^6.10.0",
    "uuid": "^9.0.0",
    "jimp": "^0.22.8"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0",
    "mocha": "^10.2.0"
  },
  "private": true
}
